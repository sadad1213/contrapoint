; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Contrapoint"
config/version="DevBuild301026"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon-contrapoint-v2.png"

[autoload]

GamePreferences="*res://ui/GamePreferences.cs"
BuildVersion="*res://ui/BuildVersion.cs"
LanSession="*res://network/LanSession.cs"
RoundState="*res://gameplay/RoundState.cs"
DefuseState="*res://gameplay/DefuseState.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Contrapoint"

[gui]

common/auto_focus_strategy=1

[input]

move_forward={
"deadzone": 0.2,
"events": []
}
move_back={
"deadzone": 0.2,
"events": []
}
move_left={
"deadzone": 0.2,
"events": []
}
move_right={
"deadzone": 0.2,
"events": []
}
jump={
"deadzone": 0.2,
"events": []
}
duck={
"deadzone": 0.2,
"events": []
}
walk={
"deadzone": 0.2,
"events": []
}
jump_scroll={
"deadzone": 0.2,
"events": []
}

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

common/physics_ticks_per_second=66
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
lights_and_shadows/multi_bounce_occlusion/enabled=true
occlusion_culling/use_occlusion_culling=true
